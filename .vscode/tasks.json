{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C: gcc build active file",
            "command": "gcc",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "objdump AT&T",
            "command": "bash",
            "args": [
                "-c",
                "objdump -D \"${fileDirname}/${fileBasenameNoExtension}\" | grep -A20 main.:"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "objdump Intel",
            "command": "bash",
            "args": [
                "-c",
                "objdump -M intel -D \"${fileDirname}/${fileBasenameNoExtension}\" | grep -A20 main.:"
            ],
            "problemMatcher": []
        }
    ]
}